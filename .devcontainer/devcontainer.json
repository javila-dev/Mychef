{
  // Para abrir la app desde el celular o cualquier navegador con GitHub Codespaces:
  // en GitHub → Code → Codespaces → Create codespace. Instala, carga ejemplos y arranca sola.
  "name": "MyChef",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && python -m app.seed",
  "postStartCommand": "nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/mychef.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "MyChef", "onAutoForward": "openBrowser" }
  },
  "containerEnv": { "MYCHEF_TZ": "America/Bogota" },
  // Claves opcionales como secretos de Codespaces: Gemini para fotos, OpenAI para texto y voz.
  "secrets": {
    "GEMINI_API_KEY": { "description": "Recomendada: con ella funciona toda la IA (fotos, voz y menú)" },
    "OPENAI_API_KEY": { "description": "Opcional: si prefieren OpenAI para el texto (con Gemini alcanza para todo)" }
  }
}
