# Copien este archivo como .env y llenen lo que necesiten. Todo es opcional.

# IA: Gemini lee las fotos (facturas, nevera, recetas) y OpenAI el texto y la voz.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Entrar con usuario y contraseña: obligatorio si la app queda publicada en internet (un VPS).
# MYCHEF_SECRET: una cadena larga y aleatoria (firma las sesiones; cambiarla cierra todas).
MYCHEF_USER=
MYCHEF_PASSWORD=
MYCHEF_SECRET=
# O, solo dentro de la red de la casa, un PIN (más cómodo, menos seguro)
MYCHEF_PIN=

# Agenda sincronizada con el calendario de Google: el JSON de la cuenta de servicio (ruta o contenido).
# Con Docker no hace falta: basta con dejar el archivo en data/google.json. El calendario se elige en
# Administrar → Casa.
MYCHEF_GOOGLE_CREDENTIALS=

# Zona horaria de la casa
MYCHEF_TZ=America/Bogota

# Solo para docker-compose.dev.yml (MinIO local). La contraseña debe tener 8 caracteres o más.
MYCHEF_S3_ACCESS_KEY=mychef
MYCHEF_S3_SECRET_KEY=mychef-secret
MYCHEF_S3_BUCKET=mychef

# Puertos de docker-compose.dev.yml en este computador
MYCHEF_DEV_PORT=8001
MYCHEF_DEV_PG_PORT=5433
MYCHEF_DEV_MINIO_PORT=9002
MYCHEF_DEV_MINIO_CONSOLE_PORT=9003
